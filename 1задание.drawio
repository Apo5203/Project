        <mxCell id="jwnCXlH7z-41eZhIXMiG-26" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#E07A5F;fontColor=#393C56;fillColor=#F2CC8F;" value="&lt;strong data-start=&quot;0&quot; data-end=&quot;20&quot;&gt;Ментальные карты&lt;/strong&gt; — это &lt;strong data-start=&quot;27&quot; data-end=&quot;73&quot; data-is-only-node=&quot;&quot;&gt;графический способ визуализации информации&lt;/strong&gt;, при котором учебный материал &lt;strong data-start=&quot;104&quot; data-end=&quot;151&quot;&gt;структурируется вокруг центрального понятия&lt;/strong&gt; и представляется в виде разветвлённой схемы взаимосвязанных идей и понятий." vertex="1">
          <mxGeometry height="168" width="332" x="375.75" y="896" as="geometry" />
        </mxCell>
        <mxCell id="jwnCXlH7z-41eZhIXMiG-27" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#E07A5F;fontColor=#393C56;fillColor=#F2CC8F;" value="&lt;strong data-start=&quot;0&quot; data-end=&quot;19&quot;&gt;Интерактивность&lt;/strong&gt; — это &lt;strong data-start=&quot;26&quot; data-end=&quot;79&quot; data-is-only-node=&quot;&quot;&gt;свойство учебной информации или средства обучения&lt;/strong&gt;, при котором обучающийся &lt;strong data-start=&quot;105&quot; data-end=&quot;145&quot;&gt;активно взаимодействует с материалом&lt;/strong&gt;, влияя на его содержание, форму или ход изучения." vertex="1">
          <mxGeometry height="168" width="332" x="765" y="896" as="geometry" />
